---
import { getCollection } from 'astro:content';
import Note from '../../views/Note.astro';
import { splitId } from '../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('notes', (e) => !e.data.draft && splitId(e.id).locale === 'en');
  return entries.map((entry) => ({ params: { slug: splitId(entry.id).slug }, props: { entry } }));
}
const { entry } = Astro.props;
---

<Note entry={entry} locale="en" />
