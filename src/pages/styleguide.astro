---
// Design system (Void Liturgy). EN only, noindex, excluded from the sitemap.
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Leaf from '../components/Leaf.astro';
import Door from '../components/Door.astro';
import Ornament from '../components/Ornament.astro';
import StatusTag from '../components/StatusTag.astro';
import Frame from '../components/Frame.astro';
import Portrait from '../components/Portrait.astro';
import Sigil from '../components/Sigil.astro';
import TrackList from '../components/TrackList.astro';
import tokensCss from '../styles/tokens.css?raw';
import { contrast, hexTokens, PAIRS } from '../lib/contrast';
import { works } from '../lib/content';
import { caseGraph } from '../lib/sigil/graphs';
import { recordGraph } from '../lib/sigil/record';
import { generateSigil } from '../lib/sigil/generate';

const hex = hexTokens(tokensCss);
const swatches = ['bg', 'surface', 'surface-2', 'ink', 'soft', 'muted', 'line', 'line-strong', 'accent', 'on-accent'];
const pairs = PAIRS.map((p) => ({ ...p, ratio: contrast(hex[p.fg] ?? '#000', hex[p.bg] ?? '#000') }));
const tracks = await works('en');
const sideA = tracks.filter((t) => t.data.side === 'A');
const a2 = tracks.find((t) => t.data.id === 'A2');
const record = recordGraph(tracks);
const recordSeed = generateSigil(record, 'record').seed.toString(16);
const scale = [
  ['--step-5', 'Automation & AI', 'section title'],
  ['--step-4', '20+ workflows, about six hours a day', 'page title'],
  ['--step-3', 'What broke', 'h2'],
  ['--step-2', 'A WhatsApp assistant that remembers through Qdrant', 'track headline'],
  ['--step-1', 'Built as my capstone. I use it daily.', 'lede, h3'],
  ['--step-0', 'n8n orchestrates it all, with Supabase and Redis, self-hosted with Docker.', 'body'],
  ['--step--1', 'Recreated with fake data.', 'small print'],
] as const;
const motion = [
  ['--dur-instant', '0ms', 'focus rings, active states'],
  ['--dur-fast', '120ms', 'link colour on hover'],
  ['--dur-base', '300ms', 'door and row fills'],
  ['--dur-reveal', '1100ms', 'dither reveal of a figure as it scrolls in'],
  ['--dur-materialize', '1800ms', 'hero sigil arriving through the Bayer threshold'],
  ['--dur-breath', '9s', 'one breathing cycle of the hero sigil'],
  ['--ease-ink', 'cubic-bezier(.4, 0, .2, 1)', 'everything that fades or fills'],
  ['--ease-out', 'cubic-bezier(.16, 1, .3, 1)', 'things that arrive'],
] as const;
const space = ['3xs', '2xs', 'xs', 's', 'm', 'l', 'xl', '2xl', '3xl'];
---

<Base
  locale="en"
  title="Styleguide · Marcelo Ribeiro Lima (Cello)"
  description="Design system for this site: tokens, type, components, sigils."
  standalone
>
  <SectionHead
    level={1}
    id="sg"
    kicker="Design system"
    meta="Void Liturgy"
    title="Styleguide"
    note="Not linked from the site, not indexed. Every value here is read from the real tokens and components."
  />

  <!-- 1. Title page -->
  <section aria-labelledby="sg-title-page" class="sg-block">
    <Leaf>
      <Fragment slot="margin">
        <span class="rubric">01</span>
        <br />
        Title page
      </Fragment>
      <h2 id="sg-title-page" class="sg-h">
        The title page
      </h2>
      <p class="sg-p">
        The home hero without WebGL: the SVG sigil is the fallback. With WebGL it is replaced by the liquid-metal render of the same sigil.
      </p>
    </Leaf>
    <div class="title-page">
      {a2 && <Sigil graph={caseGraph(a2).graph} seedKey="A2" class="tp-sigil" />}
      <p class="wordmark tp-word" aria-hidden="true">
        Cello
      </p>
      <p class="small-caps tp-name">Marcelo Ribeiro Lima</p>
      <Ornament />
      <p class="tp-lede">I build automations with n8n and LLMs. I also design and build websites.</p>
      <div class="tp-doors">
        <Door href="#sg-tracks" kicker="Side A" label="Automation & AI" />
        <Door href="#sg-tracks" kicker="Side B" label="Full-stack & Web" />
      </div>
    </div>
  </section>

  <!-- 2. Wordmark -->
  <section aria-labelledby="sg-wordmark" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">02</span>
        <br />
        Wordmark
      </Fragment>
      <h2 id="sg-wordmark" class="sg-h">
        Jacquard 24, on its grid
      </h2>
      <p class="sg-p">
        Jacquard 24 is drawn on a 24-pixel grid, so the wordmark only uses multiples of 24px. Off-grid sizes blur its pixels. It sets
        "Cello", the 404 page and ornament words, never information.
      </p>
      <div class="wm-row">
        {['wordmark-s', 'wordmark-m', 'wordmark-l', 'wordmark-xl'].map((t) => (
          <figure>
            <p class:list={['wordmark', t]} aria-hidden="true">
              Cello
            </p>
            <figcaption class="mono">--{t}</figcaption>
          </figure>
        ))}
      </div>
    </Leaf>
  </section>

  <!-- 3. Colour -->
  <section aria-labelledby="sg-colour" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">03</span>
        <br />
        Colour
      </Fragment>
      <h2 id="sg-colour" class="sg-h">
        One accent: vermilion
      </h2>
      <p class="sg-p">
        Vermilion marks what is current or important: rubrics and positions, the ornament rule, frame corners, the current page and
        language, focus rings, and the halo dots behind the hero sigil.
      </p>
      <ul class="swatches">
        {swatches.map((name) => (
          <li>
            <span class:list={['chip', `chip-${name}`]}></span>
            <span class="mono">--{name}</span>
            <span class="mono muted">{hex[name]}</span>
          </li>
        ))}
      </ul>
      <table class="pairs">
        <caption class="mono">Contrast, computed from tokens.css at build time</caption>
        <thead>
          <tr>
            <th scope="col">Text</th>
            <th scope="col">On</th>
            <th scope="col">Ratio</th>
            <th scope="col">Needs</th>
            <th scope="col">Used for</th>
          </tr>
        </thead>
        <tbody>
          {pairs.map((p) => (
            <tr>
              <td class="mono">--{p.fg}</td>
              <td class="mono">--{p.bg}</td>
              <td class:list={['mono', { fail: p.ratio < p.min }]}>{p.ratio.toFixed(2)}:1</td>
              <td class="mono">{p.min}:1</td>
              <td>{p.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </Leaf>
  </section>

  <!-- 4. Type -->
  <section aria-labelledby="sg-type" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">04</span>
        <br />
        Type
      </Fragment>
      <h2 id="sg-type" class="sg-h">
        Newsreader reads, Departure Mono labels
      </h2>
      <ol class="scale">
        {scale.map(([tok, sample, use]) => (
          <li>
            <span class:list={['sample', `s${tok.replace('--step', '')}`]}>{sample}</span>
            <span class="mono muted">
              {tok} · {use}
            </span>
          </li>
        ))}
      </ol>
      <p class="sg-p">
        <em>Italic carries asides and the lede.</em> <span class="small-caps">Small caps carry the full name.</span>
      </p>
      <p class="mono">Departure Mono · marginalia · status · stack · Jan–Jun 2026 · TOEIC 870/990 (Gold)</p>
      <p class="rubric">Rubric · Side A · 3 tracks</p>
    </Leaf>
  </section>

  <!-- 5. A/B -->
  <section aria-labelledby="sg-ab" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">05</span>
        <br />
        Decided
      </Fragment>
      <h2 id="sg-ab" class="sg-h">
        Blackletter or serif for section titles and positions
      </h2>
      <p class="sg-p">
        Decided: serif. Blackletter A and I misread ("AI" looks like "XI"), so Jacquard 24 stays on the wordmark, the 404 and ornament
        words. The rejected option is kept here for reference.
      </p>
    </Leaf>
    <div class="ab">
      <div class="ab-col">
        <p class="rubric ab-label">A · Serif (chosen)</p>
        <SectionHead kicker="Side A" meta="3 tracks" title="Automation & AI" id="ab-serif" />
        <p class="ab-pos">
          <span class="pos-serif">A1</span>
          <span class="pos-serif">A2</span>
          <span class="pos-serif">B4</span>
        </p>
        <p class="drop drop-serif">My name is Marcelo, but most people call me Cello.</p>
      </div>
      <div class="ab-col heads-blackletter">
        <p class="rubric ab-label">B · Blackletter (not chosen)</p>
        <SectionHead kicker="Side A" meta="3 tracks" title="Automation & AI" id="ab-black" />
        <p class="ab-pos">
          <span class="pos-black">A1</span>
          <span class="pos-black">A2</span>
          <span class="pos-black">B4</span>
        </p>
        <p class="drop drop-black">My name is Marcelo, but most people call me Cello.</p>
      </div>
    </div>
  </section>

  <!-- 6. Grid and space -->
  <section aria-labelledby="sg-grid" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">06</span>
        <br />
        Grid
      </Fragment>
      <h2 id="sg-grid" class="sg-h">
        The codex grid
      </h2>
      <p class="sg-p">
        A margin column for rubrics and marginalia, a text column capped at 64 characters, an ornament column for the sigil. Below 860px the
        margin folds above the text.
      </p>
      <div class="grid-demo" aria-hidden="true">
        <span>margin · --margin-col</span>
        <span>text · --measure</span>
        <span>sigil · --ornament-col</span>
      </div>
      <ul class="space">
        {space.map((s) => (
          <li>
            <span class:list={['bar', `sp-${s}`]}></span>
            <span class="mono muted">--space-{s}</span>
          </li>
        ))}
      </ul>
    </Leaf>
  </section>

  <!-- 7. Motion -->
  <section aria-labelledby="sg-motion" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">07</span>
        <br />
        Motion
      </Fragment>
      <h2 id="sg-motion" class="sg-h">
        Slow ritual, instant feedback
      </h2>
      <table class="pairs">
        <caption class="mono">Motion tokens. All zero under prefers-reduced-motion.</caption>
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Value</th>
            <th scope="col">Used for</th>
          </tr>
        </thead>
        <tbody>
          {motion.map(([tok, val, use]) => (
            <tr>
              <td class="mono">{tok}</td>
              <td class="mono">{val}</td>
              <td>{use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </Leaf>
  </section>

  <!-- 8. Components -->
  <section aria-labelledby="sg-components" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">08</span>
        <br />
        Components
      </Fragment>
      <h2 id="sg-components" class="sg-h">
        Parts
      </h2>
      <h3 class="sg-h3">Doors</h3>
      <div class="row-gap">
        <Door href="#sg-components" kicker="Side A" label="Automation & AI" />
        <Door href="#sg-components" kicker="CV" label="Download the PDF" />
      </div>
      <h3 class="sg-h3">Links and focus</h3>
      <p class="sg-p">
        A <a href="#sg-components">plain link</a> turns vermilion on hover. Press Tab: every focusable thing gets the same 2px vermilion
        ring, instantly.
      </p>
      <h3 class="sg-h3">Status</h3>
      <div class="row-gap">
        <StatusTag label="Past role" />
        <StatusTag label="Still open" tone="open" />
        <StatusTag label="Fixed" tone="done" />
      </div>
      <h3 class="sg-h3">Missing facts</h3>
      <p class="sg-p">
        When a fact is missing the page says so: <mark data-todo>TODO (Cello): why a router instead of one agent</mark>
      </p>
      <h3 class="sg-h3">Ornament rule</h3>
      <Ornament />
      <h3 class="sg-h3">Frame and portrait</h3>
      <div class="portraits">
        <Portrait alt="Portrait of Marcelo Ribeiro Lima, dithered in bone" caption="Fig. I · bone" showMeta />
        <Portrait alt="Portrait of Marcelo Ribeiro Lima, dithered in vermilion" tone="accent" caption="Fig. II · vermilion" showMeta />
      </div>
      <h3 class="sg-h3">Framed figure</h3>
      <Frame>
        <p class="mono">Recreated with fake data</p>
        <p class="sg-p">Mocks for B3 and B4 sit in this frame with a permanent label.</p>
      </Frame>
    </Leaf>
  </section>

  <!-- 9. Tracklist -->
  <section aria-labelledby="sg-tracks-title" class="sg-block" id="sg-tracks">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">09</span>
        <br />
        Tracklist
      </Fragment>
      <p class="sg-p">The section head and tracklist below are the real components with real Side A content.</p>
    </Leaf>
    <SectionHead
      kicker="Side A"
      meta={`${sideA.length} tracks`}
      title="Automation & AI"
      id="sg-tracks-title"
      note="The tracklist with real content. Hover or focus a row."
    />
    <TrackList entries={sideA} locale="en" />
  </section>

  <!-- 10. Sigils -->
  <section aria-labelledby="sg-sigils" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">10</span>
        <br />
        Sigils
      </Fragment>
      <h2 id="sg-sigils" class="sg-h">
        One per case, from its own graph
      </h2>
      <p class="sg-p">
        Side A sigils come from the architecture diagram in the case file. Side B cases have no diagram, so theirs come from the stack. Same
        graph in, same sigil out, with at most 12 nodes. A graph with fewer than 4 nodes gets ornamental thorns that carry no data, so it
        never draws a bare cross.
      </p>
    </Leaf>
    <ul class="sigils">
      {tracks.map((t) => {
        const g = caseGraph(t);
        return (
          <li>
            <Sigil graph={g.graph} seedKey={t.data.id} />
            <p class="mono">
              {t.data.side}
              {t.data.order} · {t.data.name}
            </p>
            <p class="mono muted">
              {g.source === 'diagram' ? 'from the diagram' : 'from the case details and stack'} · {g.graph.nodes.length}{' '}
              {g.graph.nodes.length === 1 ? 'node' : 'nodes'}
            </p>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- 11. Hero candidates -->
  <section aria-labelledby="sg-hero" class="sg-block">
    <Leaf ruled>
      <Fragment slot="margin">
        <span class="rubric">11</span>
        <br />
        Decided
      </Fragment>
      <h2 id="sg-hero" class="sg-h">
        Which sigil opens the home page
      </h2>
      <p class="sg-p">
        Decided: the record sigil. It is built from the record itself: one pair of thorns per published track, a spur wherever two tracks
        share a stack item, so it changes when a case is added. The A2 sigil is kept here for reference.
      </p>
    </Leaf>
    <div class="ab">
      <figure class="ab-col hero-cand">
        <Sigil graph={record} seedKey="record" />
        <figcaption>
          <p class="rubric">A · Record sigil (chosen)</p>
          <p class="mono muted">
            {record.nodes.length} tracks · {record.edges.length} shared-stack links · seed {recordSeed}
          </p>
          <ul class="mono shared">
            {record.shared.map((s) => (
              <li>
                {s.from}–{s.to}: {s.via.join(', ')}
              </li>
            ))}
          </ul>
        </figcaption>
      </figure>
      <figure class="ab-col hero-cand">
        {a2 && <Sigil graph={caseGraph(a2).graph} seedKey="A2" />}
        <figcaption>
          <p class="rubric">B · A2 sigil (not chosen)</p>
          {a2 && (
            <p class="mono muted">
              WhatsApp assistant · current diagram · {caseGraph(a2).graph.nodes.length} nodes · {caseGraph(a2).graph.edges.length} edges
            </p>
          )}
        </figcaption>
      </figure>
    </div>
    <div class="divider-demo">
      <p class="mono muted">The record sigil on its side, as the divider band between sections</p>
      <Sigil graph={record} seedKey="record" sideways class="divider-sigil" />
    </div>
  </section>
</Base>

<style>
  .sg-block {
    margin-top: var(--space-2xl);
  }
  .sg-h {
    font-size: var(--step-3);
  }
  .sg-h3 {
    margin-top: var(--space-l);
    margin-bottom: var(--space-xs);
    font-size: var(--step-1);
  }
  .sg-p {
    margin-top: var(--space-xs);
    color: var(--soft);
  }
  .muted {
    color: var(--muted);
  }

  .title-page {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-s);
    padding: var(--space-xl) var(--gutter);
  }
  .title-page :global(.tp-sigil) {
    width: min(15rem, 55vw);
    color: var(--ink);
  }
  .tp-word {
    font-size: var(--wordmark-l);
    margin-top: var(--space-s);
  }
  .tp-name {
    font-size: var(--step-2);
    color: var(--soft);
  }
  .tp-lede {
    font-style: italic;
    font-size: var(--step-2);
    max-width: 30ch;
    line-height: 1.35;
  }
  .tp-doors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
    margin-top: var(--space-xs);
  }

  .wm-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-l);
    margin-top: var(--space-m);
  }
  .wordmark-s {
    font-size: var(--wordmark-s);
  }
  .wordmark-m {
    font-size: var(--wordmark-m);
  }
  .wordmark-l {
    font-size: var(--wordmark-l);
  }
  .wordmark-xl {
    font-size: var(--wordmark-xl);
  }
  .wm-row figcaption {
    color: var(--muted);
  }

  .swatches {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-s);
    margin-top: var(--space-m);
  }
  .swatches li {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .chip {
    display: block;
    height: 3.5rem;
    border: var(--rule) solid var(--line-strong);
  }
  .chip-bg {
    background: var(--bg);
  }
  .chip-surface {
    background: var(--surface);
  }
  .chip-surface-2 {
    background: var(--surface-2);
  }
  .chip-ink {
    background: var(--ink);
  }
  .chip-soft {
    background: var(--soft);
  }
  .chip-muted {
    background: var(--muted);
  }
  .chip-line {
    background: var(--line);
  }
  .chip-line-strong {
    background: var(--line-strong);
  }
  .chip-accent {
    background: var(--accent);
  }
  .chip-on-accent {
    background: var(--on-accent);
  }

  .pairs {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-m);
    font-size: var(--step--1);
  }
  .pairs caption {
    text-align: left;
    color: var(--muted);
    padding-bottom: var(--space-2xs);
  }
  .pairs th,
  .pairs td {
    text-align: left;
    padding: var(--space-2xs) var(--space-xs) var(--space-2xs) 0;
    border-bottom: var(--rule) solid var(--line);
    vertical-align: top;
  }
  .pairs th {
    font-family: var(--font-mono);
    font-size: var(--mono-s);
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--muted);
    font-weight: 400;
  }
  .fail {
    color: var(--accent);
  }

  .scale {
    list-style: none;
    padding: 0;
    margin-top: var(--space-m);
    display: grid;
    gap: var(--space-s);
  }
  .scale li {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .sample {
    line-height: 1.1;
    text-wrap: balance;
  }
  .s-5 {
    font-size: var(--step-5);
  }
  .s-4 {
    font-size: var(--step-4);
  }
  .s-3 {
    font-size: var(--step-3);
  }
  .s-2 {
    font-size: var(--step-2);
  }
  .s-1 {
    font-size: var(--step-1);
  }
  .s-0 {
    font-size: var(--step-0);
  }
  .s--1 {
    font-size: var(--step--1);
  }

  .ab {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
    padding-inline: var(--gutter);
    max-width: var(--page-max);
    margin: var(--space-l) auto 0;
  }
  .ab-col {
    border: var(--rule) solid var(--line);
    padding-block: var(--space-m);
  }
  .ab-col :global(.leaf) {
    grid-template-columns: 5rem minmax(0, 1fr);
    padding-inline: var(--space-s);
  }
  .ab-col :global(.title) {
    font-size: var(--step-4);
  }
  .ab-label {
    padding-inline: var(--space-s);
    margin-bottom: var(--space-s);
  }
  .ab-pos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    padding: var(--space-m) var(--space-s) 0;
    max-width: none;
  }
  .pos-serif {
    font-style: italic;
    color: var(--accent);
    font-size: var(--step-4);
    line-height: 1;
  }
  .pos-black {
    font-family: var(--font-wordmark);
    color: var(--accent);
    font-size: var(--wordmark-m);
    line-height: 0.9;
  }
  .drop {
    padding: var(--space-m) var(--space-s) 0;
    font-size: var(--step-1);
  }
  .drop::first-letter {
    float: left;
    color: var(--accent);
    margin: 0.08em 0.12em 0 0;
    line-height: 0.8;
  }
  .drop-serif::first-letter {
    font-style: italic;
    font-size: 3.4em;
  }
  .drop-black::first-letter {
    font-family: var(--font-wordmark);
    font-size: 3.4em;
  }

  .grid-demo {
    display: grid;
