---
// B5 "What broke": the record sigil drawn twice by the real generator, once with the curl sign flipped
// back as in the first generator (ribcages), once as it is drawn now (thorns). Decorative pair with captions.
import Sigil from './Sigil.astro';
import { t, type Locale } from '../i18n';
import { works } from '../lib/content';
import { recordGraph } from '../lib/sigil/record';

const locale: Locale = Astro.currentLocale === 'pt' ? 'pt' : 'en';
const s = t(locale);
const record = recordGraph(await works(locale));
---

<div class="pair" data-reveal="dither">
  <figure>
    <Sigil graph={record} seedKey="record" weight={1.3} ribs class="pair-sigil" />
    <figcaption class="mono">{s.work.ribsBefore}</figcaption>
  </figure>
  <figure>
    <Sigil graph={record} seedKey="record" weight={1.3} class="pair-sigil" />
    <figcaption class="mono">{s.work.ribsAfter}</figcaption>
  </figure>
</div>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 12rem));
    gap: var(--space-xl);
    margin-top: var(--space-l);
  }
  .pair :global(.pair-sigil) {
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: var(--space-xs);
    color: var(--soft);
    text-transform: none;
  }
  @media (max-width: 560px) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-m);
    }
  }
</style>
