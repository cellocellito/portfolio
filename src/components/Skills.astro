---
// Three plain lists, Strong / Solid / Learning. No bars, no percentages, no icons.
import { profile } from '../data/profile';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
const p = profile(Astro.props.locale);
---

<div class="levels">
  {(['strong', 'solid', 'learning'] as const).map((level) => (
    <div class="level">
      <h3 class="level-name">{s.skills[level]}</h3>
      <ul>
        {p.skills[level].map((x) => (
          <li>{x}</li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .levels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
  }
  .level-name {
    font-family: var(--font-mono);
    font-size: var(--mono-s);
    font-weight: 400;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: var(--space-2xs);
    border-bottom: var(--rule) solid var(--line);
  }
  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
  }
  li {
    font-size: var(--step-1);
    line-height: 1.3;
  }
  li + li {
    margin-top: var(--space-2xs);
  }
  @media (max-width: 640px) {
    .levels {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
