---
// Honest status as a rubber stamp: vermilion, a double rule, a rough ink edge (the #ink filter
// in Base), set a little crooked. With motion it lands with a thunk when its row arrives (motion.css, i).
interface Props {
  label: string;
  tone?: 'neutral' | 'open' | 'done';
}
const { label, tone = 'neutral' } = Astro.props;
---

<span class:list={['status', tone]}>{label}</span>

<style>
  .status {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--mono-s);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.4;
    padding: 0.2em 0.55em;
    border: 2px solid var(--accent);
    outline: 1px solid var(--accent);
    outline-offset: 2px;
    color: var(--accent);
    transform: rotate(-6deg);
    filter: url(#ink);
    opacity: 0.94;
  }
  .done {
    text-decoration: line-through;
  }
</style>
