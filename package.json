{
  "name": "cello-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Portfolio of Marcelo \"Cello\" Ribeiro Lima: automation, AI and web work, in English and Portuguese.",
  "engines": {
    "node": "^22.23.4 || ^24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "node scripts/dither-portrait.mjs && node scripts/check-parity.mjs && astro check && astro build && node scripts/todo-report.mjs",
    "preview": "astro preview",
    "copy": "node scripts/copy-check.mjs",
    "todo": "node scripts/todo-report.mjs",
    "parity": "node scripts/check-parity.mjs",
    "predev": "node scripts/dither-portrait.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test",
    "budgets": "node scripts/check-budgets.mjs",
    "lh": "node scripts/lighthouse.mjs",
    "shots": "node scripts/shots.mjs",
    "qa": "npm run build && npm run lint && npm run copy && npm run budgets && npm test && npm run lh"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/jacquard-24": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@playwright/test": "1.65.0",
    "astro": "7.4.7",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
